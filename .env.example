COMFY_URL=http://127.0.0.1:8188
# Installs mean writing into ComfyUI's own folders (models/, custom_nodes/), which only works
# when the gateway runs on that machine or sees those folders through a mount. Nothing guesses
# that: the panel keeps installs off until this says the folders are writable from here. This
# file is the single-machine template, so it is on; leave it out on a remote gateway.
INSTALL_INTO_COMFY=1
# Gateway listen address, bound as given. For a phone on the LAN, put this machine's LAN
# address here (e.g. 192.168.3.232) or 0.0.0.0 to accept every interface; start.sh then points
# the browser at that address and lists the canvas origin for CORS.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8190
CANVAS_HOST=127.0.0.1
CANVAS_PORT=3000
