COMFY_URL=http://127.0.0.1:8188
COMFYUI_DIR=/home/wallace/comfy/ComfyUI
# The gateway installs models by writing into ComfyUI's model folders, so it belongs on the
# ComfyUI machine (or on a host where those folders are mounted). It never guesses that: model
# installs stay off in the panel until this says the folders are reachable. This file is the
# single-machine template, so it is on; leave it out when the gateway runs on another machine.
COMFY_MODELS_SHARED=1
# Listen addresses, bound as given. For a phone on the LAN, put this machine's LAN address
# here (e.g. 192.168.3.232) or 0.0.0.0 to accept every interface; start.sh then points the
# browser at that address and lists the canvas origin for CORS.
HOST=127.0.0.1
PORT=8190
CANVAS_HOST=127.0.0.1
CANVAS_PORT=3000
START_COMFY=0
COMFY_PYTHON=/home/wallace/venv-comfyui/bin/python
