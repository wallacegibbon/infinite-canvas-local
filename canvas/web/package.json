{
    "name": "infinite-canvas",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 3000",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "check:i18n": "node scripts/check-i18n.cjs",
        "check:exports": "node scripts/check-exports.cjs",
        "check": "npm run check:i18n && npm run check:exports && npm run format:check && tsc --noEmit",
        "start": "vite preview --host 0.0.0.0 --port 3000",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "copy-to-clipboard": "^4.0.2",
        "fflate": "^0.8.3",
        "file-saver": "^2.0.5",
        "i18next": "^26.3.6",
        "localforage": "^1.10.0",
        "lucide-react": "^1.16.0",
        "nanoid": "^5.1.11",
        "radix-ui": "^1.4.3",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-i18next": "^17.0.11",
        "react-router-dom": "^7.12.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0",
        "three": "^0.186.1",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^20",
        "@types/react": "19.1.12",
        "@types/react-dom": "19.1.9",
        "@types/three": "^0.186.0",
        "@vitejs/plugin-react": "^5.2.0",
        "prettier": "^3.8.3",
        "shadcn": "^4.7.0",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5",
        "vite": "^7.3.0",
        "vitest": "^3.2.7"
    }
